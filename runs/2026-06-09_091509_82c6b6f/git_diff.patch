+def latent_triplet_position_loss(
+    z_anchor: torch.Tensor,
+    z_pos: torch.Tensor,
+    z_neg: torch.Tensor,
+    cfg: Dict[str, Any],
+) -> tuple[torch.Tensor, Dict[str, float]]:
